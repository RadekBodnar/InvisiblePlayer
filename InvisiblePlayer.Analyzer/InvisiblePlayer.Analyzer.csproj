<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- NU1701: ScottPlot.WPF táhne tranzitivně SkiaSharp.Views.WPF bez
         net8.0-windows assetů (restore přes .NET Framework fallback).
         Tlumeno CÍLENĚ jen zde - globálně v Directory.Build.props by to skrylo
         budoucí NU1701 ve všech projektech (nález externího review). -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InvisiblePlayer.Core\InvisiblePlayer.Core.csproj" />
  </ItemGroup>

</Project>
